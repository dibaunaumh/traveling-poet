msgid "Change how you are named"
msgstr "לשנות איך יופיע השם"

#, elixir-autogen, elixir-format
msgid "No tips this time. Thank you for letting us know."
msgstr "בלי המלצות הפעם. תודה שעדכנתם."

#, elixir-autogen, elixir-format
msgid "Not this time"
msgstr "לא הפעם"

#, elixir-autogen, elixir-format
msgid "Read %{poet}'s journal"
msgstr "ליומן של %{poet}"

#, elixir-autogen, elixir-format
msgid "Send"
msgstr "שליחה"

#, elixir-autogen, elixir-format
msgid "Thank you. %{poet} will have your tips with the next page."
msgstr "תודה. ההמלצות יגיעו אל %{poet} עם העמוד הבא."

#, elixir-autogen, elixir-format
