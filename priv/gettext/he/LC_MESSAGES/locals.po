#, elixir-autogen, elixir-format
msgid "%{poet} will translate it if needed and check the places you name. Under it on the page: \"%{credit}\"."
msgstr "%{poet} יתרגם אם צריך ויבדוק את המקומות שתציינו. מתחת לזה בעמוד: \"%{credit}\"."

#, elixir-autogen, elixir-format
msgid "A few words, up to 1500 characters."
msgstr "כמה מילים, עד 1500 תווים."

#, elixir-autogen, elixir-format
msgid "A place, a dish, a walk, and why"
msgstr "מקום, מנה, הליכה, ולמה"

