# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
traveling_poet-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*


# Local secrets (loaded by config/runtime.exs); .env.example is the template
.env

# macOS
.DS_Store

# Eval runs (mix tpoet.eval_*): images, reports, raw artifacts
/evals/

# Agent tooling: local settings, worktrees, and the Alice.In workspace
# credentials and state. The onboarding docs and scripts stay tracked.
.claude/settings.local.json
.claude/worktrees/
.claude/alice/state.json
.claude/alice/config.json
.claude/alice/onboard/*
!.claude/alice/onboard/ONBOARD.md
!.claude/alice/onboard/MAPPING.md
!.claude/alice/onboard/ADAPTERS.md
!.claude/alice/onboard/prior.mjs
!.claude/alice/onboard/linear.mjs
.codex/alice/state.json
.codex/alice/config.json
.codex/alice/onboard/*
!.codex/alice/onboard/ONBOARD.md
!.codex/alice/onboard/MAPPING.md
!.codex/alice/onboard/ADAPTERS.md
!.codex/alice/onboard/prior.mjs
!.codex/alice/onboard/linear.mjs
