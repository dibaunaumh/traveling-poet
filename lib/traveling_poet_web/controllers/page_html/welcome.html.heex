<%!-- The iOS app's first screen for someone signed out. The website's home
      page is a pitch to a visitor who has not decided yet; someone who
      installed the app has, so this is a front door: sign in, or say where
      the poet should start and then sign in. --%>
<div class="home app-welcome">
  <main>
    <img
      src={~p"/images/hero-notebook.jpg"}
      alt={
        gettext(
          "An open sketchbook on a riverside step: a footbridge, a tram and plane trees in grey-green watercolor"
        )
      }
      class="app-welcome-art"
      width="1344"
      height="768"
      fetchpriority="high"
    />

    <h1 class="wordmark app-welcome-mark">Traveling <em>Poet</em></h1>
    <p class="app-welcome-line">
      {gettext(
        "Send someone ahead of you. Your poet travels through real places and writes you an illustrated journal page every morning."
      )}
    </p>

    <p :if={@start_place} id="welcome-place" class="app-welcome-place">
      <.rich text={
        gettext("Your poet sets out from %{place}. Sign in and it goes.", place: marker(:place))
      }>
        <:part name="place"><b>{@start_place}</b></:part>
      </.rich>
    </p>

    <div class="app-welcome-signin" id="welcome-signin">
      <%!-- First, and at least as prominent as any other way in (App Store
            guideline 4.8). The label, the mark and black-on-white follow
            Apple's button guidelines. native.js shows Apple's own sheet. --%>
      <button
        :if={@apple_nonce}
        type="button"
        id="sign-in-with-apple"
        class="app-welcome-btn app-welcome-apple"
        data-apple-nonce={@apple_nonce}
      >
        <svg viewBox="0 0 17 20" aria-hidden="true" class="app-welcome-apple-mark">
          <path
            fill="currentColor"
            d="M14.03 10.6c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.63 1.11 8.8.73 1.06 1.61 2.25 2.75 2.21 1.1-.04 1.52-.71 2.86-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.67-2.15.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.34-3.55ZM11.84 4.12c.61-.74 1.02-1.77.91-2.79-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.7-.93 2.7.98.08 1.98-.5 2.59-1.23Z"
          />
        </svg>
        {gettext("Sign in with Apple")}
      </button>
      <%!-- A plain link to the web flow. Inside the app native.js takes the
            tap and runs it in the system sign-in sheet, the only place Google
            allows it. --%>
      <a href={~p"/auth/google"} class="home-btn app-welcome-btn" data-track="cta-signin-app">
        {gettext("Continue with Google")}
      </a>
    </div>

    <form
      :if={is_nil(@start_place)}
      action={~p"/start"}
      method="get"
      class="home-hero-ask app-welcome-ask"
      role="search"
    >
      <label for="welcome-place-input" class="home-hero-ask-label">
        {gettext("New here? Where should your poet set out from?")}
      </label>
      <div class="home-hero-ask-row">
        <input
          id="welcome-place-input"
          type="text"
          name="place"
          maxlength="120"
          autocomplete="off"
          placeholder={gettext("Lisbon, Kyoto, Oaxaca…")}
        />
        <button type="submit" class="home-hero-cta">{gettext("Next")}</button>
      </div>
    </form>

    <%!-- Real pages before any sign-in: what the poets found, all of it. --%>
    <a href={~p"/discover"} class="app-welcome-sample" data-track="cta-discover-app">
      {gettext("Look around first")}
    </a>
  </main>

  <footer class="app-welcome-foot">
    <a href={~p"/privacy"}>{gettext("Privacy")}</a>
    <a href={~p"/terms"}>{gettext("Terms")}</a>
    <a href={~p"/support"}>{gettext("Support")}</a>
    <a :if={@review_login?} href={~p"/auth/review"} id="reviewer-sign-in">
      {gettext("Reviewer sign-in")}
    </a>
    <Layouts.language_switch />
  </footer>
</div>
<Layouts.flash_group flash={@flash} />
