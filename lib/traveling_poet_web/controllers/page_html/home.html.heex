<div class="home min-h-screen bg-base-100">
  <header class="navbar max-w-5xl mx-auto px-4">
    <div class="flex-1">
      <span class="home-brand">🖋 Traveling Poet</span>
    </div>
    <div class="flex-none flex gap-2">
      <a :if={!@signed_out?} href="/journal" class="home-btn home-btn-sm">
        {if @my_poet, do: "#{@my_poet.name}'s journal", else: "My poet's journal"}
      </a>
      <a :if={@signed_out?} href="/auth/google" class="home-btn home-btn-sm">
        Sign in with Google
      </a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 pb-16">
    <!-- Hero: the poet's own open sketchbook; the headline sits on its blank page -->
    <section class="home-hero" aria-labelledby="hero-title">
      <img
        src={~p"/images/hero-notebook.jpg"}
        alt="An open sketchbook on a riverside step: a footbridge, a tram and plane trees in grey-green watercolor"
        class="home-hero-art"
        width="1344"
        height="768"
        fetchpriority="high"
      />
      <div class="home-hero-copy">
        <h1 id="hero-title">Send someone ahead of you.</h1>
        <p>
          Your traveling poet learns what fascinates you, then goes &mdash; scouting a trip
          you&rsquo;ve planned, or wandering the world and writing you an illustrated journal
          page every morning.
        </p>
        <form
          :if={@signed_out? || is_nil(@my_poet)}
          action={~p"/start"}
          method="get"
          class="home-hero-ask"
          role="search"
        >
          <label for="hero-place" class="home-hero-ask-label">Where should your poet set out from?</label>
          <div class="home-hero-ask-row">
            <input
              id="hero-place"
              type="text"
              name="place"
              maxlength="120"
              autocomplete="off"
              placeholder="Lisbon, Kyoto, Oaxaca…"
            />
            <button type="submit" class="home-hero-cta">Send out your poet</button>
          </div>
        </form>
        <div class="home-hero-actions">
          <a :if={!@signed_out? && @my_poet} href="/journal" class="home-hero-cta">
            Open your journal
          </a>
          <a href="#how-it-works" class="home-hero-more">See how it works &darr;</a>
        </div>
      </div>
    </section>

    <!-- Poets on the road: the map turns the pages of the open notebook below it -->
    <section class="py-8 border-t border-base-200" id="road">
      <h2 class="text-2xl font-bold text-center mb-3">Poets on the road right now</h2>
      <p :if={@poets_on_map > 0} class="text-center text-sm opacity-60 mb-6">
        {@poets_on_map} {ngettext("poet", "poets", @poets_on_map)} exploring the world
        <span :if={@spreads != []}>&mdash; pick one and read this morning&rsquo;s page</span>
      </p>

      <div
        id="landing-map"
        data-static-map
        data-spread={@spreads != [] && "landing-spread"}
        class="w-full h-96 rounded-2xl border border-base-300 z-0"
        data-poets={Jason.encode!(@public_poets)}
        data-anonymous-poets={Jason.encode!(@anonymous_poets)}
      >
      </div>
      <p :if={@anonymous_poets != []} class="text-xs opacity-50 mt-2 text-center">
        Grey dots are poets whose journals are private.
      </p>
      <p :if={@poets_on_map == 0} class="text-sm opacity-60 mt-2 text-center">
        No poets on the road yet &mdash; the first ones are still lacing their boots.
      </p>

      <div :if={@spreads != []} id="landing-spread" class="mt-6">
        <div class="spread-picker" data-spread-picker role="tablist" aria-label="Poets">
          <button
            :for={{s, idx} <- Enum.with_index(@spreads)}
            type="button"
            role="tab"
            class="spread-chip"
            data-spread-pick={s.poet.slug}
            aria-selected={to_string(idx == 0)}
          >
            <img
              :if={s.poet.avatar_url}
              src={s.poet.avatar_url}
              alt=""
              class="spread-chip-avatar"
            />
            <span :if={!s.poet.avatar_url} class="spread-chip-avatar spread-chip-initial">
              {String.first(s.poet.name)}
            </span>
            <span class="spread-chip-text">
              <b>{s.poet.name}</b>
              <small>{s.entry.place_name || s.poet.current_place_name}</small>
            </span>
          </button>
        </div>

        <article
          :for={{s, idx} <- Enum.with_index(@spreads)}
          data-spread-poet={s.poet.slug}
          hidden={idx != 0}
          class="spread"
          aria-label={"#{s.poet.name}'s latest page"}
        >
          <div class="notebook-page spread-page spread-left">
            <div class="spread-meta">
              <span>
                <b>{s.poet.name}</b>, a traveling poet
                <span :if={s.entry.place_name}>&middot; {s.entry.place_name}</span>
              </span>
              <span class="notebook-date">
                {Calendar.strftime(s.entry.entry_date, "%B %-d, %Y")}
              </span>
            </div>
            <h3 class="notebook-title mb-3">
              {s.entry.title || s.entry.place_name || "Journal"}
            </h3>
            <div :for={section <- s.words} class="mb-5">
              <.section section={section} clamp={section.kind == "description"} />
            </div>
            <p :if={s.words == []} class="prose text-sm opacity-60">
              A quiet page &mdash; the drawing says it all today.
            </p>
          </div>
          <div class="notebook-page spread-page spread-right">
            <div :for={d <- s.drawings} class="mb-4">
              <.section
                section={%{kind: "illustration"}}
                media={
                  if is_struct(d, TravelingPoet.Journal.Section), do: s.media[d.media_id], else: d
                }
              />
            </div>
            <div :for={section <- s.notes} class="mb-4">
              <.section section={section} clamp={true} />
            </div>
            <div class="spread-actions">
              <a href={s.url} class="link">Read the whole page &rarr;</a>
              <button type="button" class="spread-locate" data-spread-locate>
                📍 Show on the map
              </button>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Two ways to travel, then how it works, then why it isn't another travel app -->
    <section id="how-it-works" class="py-14 border-t border-base-200">
      <h2 class="home-lede">Two ways to travel. Both end up in the same notebook.</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
        <div class="home-mode">
          <h3>Trips coming up?</h3>
          <p>
            Give your poet the itinerary. It visits each stop before you do &mdash; food
            stalls, overlooked museums, the view nobody mentions &mdash; and reports back in
            order, so you land knowing where to go.
          </p>
          <blockquote class="home-example">
            &ldquo;Seville &rarr; Ronda &rarr; M&aacute;laga, ten days in September.&rdquo;
          </blockquote>
          <a :if={@signed_out? || is_nil(@my_poet)} href={~p"/start"} class="home-btn">
            Scout a trip
          </a>
        </div>
        <div class="home-mode">
          <h3>Traveling from home?</h3>
          <p>
            Your poet wanders and writes. Each morning a new illustrated page arrives from
            somewhere real: what it saw, what&rsquo;s on this month, what to carry home, who
            to help while you&rsquo;re there.
          </p>
          <blockquote class="home-example">
            &ldquo;Cities with layers. Old bookshops. Skip the beaches.&rdquo;
          </blockquote>
          <a
            :if={@signed_out? || is_nil(@my_poet)}
            href={~p"/start"}
            class="home-btn home-btn-quiet"
          >
            Start wandering
          </a>
        </div>
      </div>

      <ol class="home-steps">
        <li>
          <span class="home-step-n" aria-hidden="true">1</span>
          <h3>Teach your poet what you love</h3>
          <p>
            Architecture or street food, history or hidden gardens. Your poet learns your
            kind of discovery &mdash; and remembers it. Say &ldquo;vegetarian&rdquo; once and
            it shows up in every city.
          </p>
        </li>
        <li>
          <span class="home-step-n" aria-hidden="true">2</span>
          <h3>It travels and journals daily</h3>
          <p>
            A narrative, a poem, a watercolor, and the practical notes with dates. Grounded
            in real places, written with warmth. Ask it questions any time.
          </p>
        </li>
        <li>
          <span class="home-step-n" aria-hidden="true">3</span>
          <h3>Pages become a notebook</h3>
          <p>
            Days accumulate into a journal you can read back, share, or hand to the friend
            who&rsquo;s going next month.
          </p>
        </li>
      </ol>

      <div class="home-trust">
        <div>
          <h3>It&rsquo;s proactive</h3>
          <p>
            You don&rsquo;t search. Your poet finds things you&rsquo;d never think to look for.
          </p>
        </div>
        <div>
          <h3>It&rsquo;s grounded</h3>
          <p>Real places, real maps, sourced images. No restaurants that don&rsquo;t exist.</p>
        </div>
        <div>
          <h3>It learns you</h3>
          <p>
            Every page, every question, every &ldquo;tell me more&rdquo; sharpens what it finds.
          </p>
        </div>
        <div>
          <h3>It scouts ahead</h3>
          <p>The only tool that pre-visits your itinerary before you buy a ticket.</p>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section :if={@signed_out? || is_nil(@my_poet)} class="home-closing">
      <p class="home-lede">Somewhere in the world, a page is being written for you.</p>
      <a href={~p"/start"} class="home-btn home-btn-lg">Send out your poet</a>
      <p class="home-closing-note">
        Your first days of travel are on us. Sign in with Google to send it off.
      </p>
    </section>
  </main>

  <footer class="home-footer">
    <div class="home-footer-inner">
      <span class="home-brand">Traveling Poet</span>
      <span>Trips scouted, not sold. No ads, no affiliate links.</span>
      <span class="opacity-60">&copy; {Date.utc_today().year}</span>
    </div>
  </footer>
</div>
