<div class="min-h-screen bg-base-100">
  <header class="navbar max-w-5xl mx-auto px-4">
    <div class="flex-1">
      <span class="text-xl font-semibold">🖋 Traveling Poet</span>
    </div>
    <div class="flex-none flex gap-2">
      <a :if={!@signed_out?} href="/journal" class="btn btn-primary btn-sm">
        {if @my_poet, do: "#{@my_poet.name}'s journal", else: "My poet's journal"}
      </a>
      <a :if={@signed_out?} href="/auth/google" class="btn btn-primary btn-sm">
        Sign in with Google
      </a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 pb-16">
    <!-- Hero: the poet's own open sketchbook; the headline sits on its blank page -->
    <section class="home-hero" aria-labelledby="hero-title">
      <img
        src={~p"/images/hero-notebook.jpg"}
        alt="An open sketchbook on a riverside step: a footbridge, a tram and plane trees in grey-green watercolor"
        class="home-hero-art"
        width="1344"
        height="768"
        fetchpriority="high"
      />
      <div class="home-hero-copy">
        <h1 id="hero-title">Send someone ahead of you.</h1>
        <p>
          Your traveling poet learns what fascinates you, then goes &mdash; scouting a trip
          you&rsquo;ve planned, or wandering the world and writing you an illustrated journal
          page every morning.
        </p>
        <div class="home-hero-actions">
          <a :if={@signed_out?} href="/auth/google" class="home-hero-cta">
            Send out your poet
          </a>
          <a :if={!@signed_out?} href="/journal" class="home-hero-cta">
            Open your journal
          </a>
          <a href="#how-it-works" class="home-hero-more">See how it works &darr;</a>
        </div>
        <small :if={@signed_out?}>Your first days of travel are on us. Sign in with Google.</small>
      </div>
    </section>

    <!-- Poets on the road -->
    <section class="py-8 border-t border-base-200">
      <h2 class="text-2xl font-bold text-center mb-3">Poets on the road right now</h2>
      <p :if={@poets_on_map > 0} class="text-center text-sm opacity-60 mb-6">
        {@poets_on_map} {ngettext("poet", "poets", @poets_on_map)} exploring the world
      </p>

      <div
        id="landing-map"
        data-static-map
        class="w-full h-96 rounded-2xl border border-base-300 z-0"
        data-poets={Jason.encode!(@public_poets)}
        data-anonymous-poets={Jason.encode!(@anonymous_poets)}
      >
      </div>
      <p :if={@anonymous_poets != []} class="text-xs opacity-50 mt-2 text-center">
        Grey dots are poets whose journals are private.
      </p>
      <p :if={@poets_on_map == 0} class="text-sm opacity-60 mt-2 text-center">
        No poets on the road yet &mdash; the first ones are still lacing their boots.
      </p>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="py-12 border-t border-base-200">
      <h2 class="text-2xl font-bold text-center mb-10">How it works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center px-4">
          <div class="text-3xl mb-3">1.</div>
          <h3 class="text-lg font-semibold mb-2">Teach your poet what you love</h3>
          <p class="opacity-70 text-sm">
            Tell us about your tastes &mdash; architecture or street food, history or
            hidden gardens. Your poet learns your kind of discovery.
          </p>
        </div>
        <div class="text-center px-4">
          <div class="text-3xl mb-3">2.</div>
          <h3 class="text-lg font-semibold mb-2">Your poet travels &amp; journals daily</h3>
          <p class="opacity-70 text-sm">
            Each day a new illustrated entry arrives: what your poet saw, learned, and
            uncovered. Grounded in real places, written with warmth. You can ask
            questions anytime.
          </p>
        </div>
        <div class="text-center px-4">
          <div class="text-3xl mb-3">3.</div>
          <h3 class="text-lg font-semibold mb-2">Scout any trip before you go</h3>
          <p class="opacity-70 text-sm">
            Got a trip coming up? Give your poet the itinerary. It scouts every stop in
            order &mdash; hidden food stalls, overlooked museums, the view nobody mentions
            &mdash; so you land knowing exactly where to go.
          </p>
        </div>
      </div>
    </section>

    <!-- Two ways to travel -->
    <section class="py-12">
      <h2 class="text-2xl font-bold text-center mb-8">Two ways to travel</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card bg-base-200 shadow-sm">
          <div class="card-body text-center">
            <div class="text-3xl mb-2">🧭</div>
            <h3 class="card-title justify-center text-lg">Trips coming up?</h3>
            <p class="opacity-70 text-sm">
              Scout your itinerary. Your poet visits each stop before you do and reports
              what&rsquo;s worth your time &mdash; so you land knowing exactly where to go.
            </p>
            <div :if={@signed_out?} class="card-actions justify-center mt-2">
              <a href="/auth/google" class="btn btn-outline btn-sm">
                Scout a trip &rarr;
              </a>
            </div>
          </div>
        </div>
        <div class="card bg-base-200 shadow-sm">
          <div class="card-body text-center">
            <div class="text-3xl mb-2">🏠</div>
            <h3 class="card-title justify-center text-lg">Traveling from home?</h3>
            <p class="opacity-70 text-sm">
              Your poet wanders the world, sending daily illustrated journals from real
              places. You wake up to discovery without leaving your chair.
            </p>
            <div :if={@signed_out?} class="card-actions justify-center mt-2">
              <a href="/auth/google" class="btn btn-outline btn-sm">
                Start wandering &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why this isn't another travel app -->
    <section class="py-12 border-t border-base-200">
      <h2 class="text-2xl font-bold text-center mb-8">Why this isn&rsquo;t another travel app</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <div class="flex gap-3">
          <div class="text-xl mt-0.5 shrink-0">🔍</div>
          <div>
            <h3 class="font-semibold text-sm">It&rsquo;s proactive</h3>
            <p class="opacity-70 text-sm">
              You don&rsquo;t search. Your poet finds things you&rsquo;d never think to look for.
            </p>
          </div>
        </div>
        <div class="flex gap-3">
          <div class="text-xl mt-0.5 shrink-0">🧠</div>
          <div>
            <h3 class="font-semibold text-sm">It learns you</h3>
            <p class="opacity-70 text-sm">
              Every journal, every question, every &ldquo;tell me more&rdquo; sharpens what it finds.
            </p>
          </div>
        </div>
        <div class="flex gap-3">
          <div class="text-xl mt-0.5 shrink-0">📍</div>
          <div>
            <h3 class="font-semibold text-sm">It&rsquo;s grounded</h3>
            <p class="opacity-70 text-sm">
              Real places, real maps, real discoveries. No hallucinations about restaurants that don&rsquo;t exist.
            </p>
          </div>
        </div>
        <div class="flex gap-3">
          <div class="text-xl mt-0.5 shrink-0">✈️</div>
          <div>
            <h3 class="font-semibold text-sm">It scouts ahead</h3>
            <p class="opacity-70 text-sm">
              The only tool that pre-visits your itinerary and reports back before you buy a plane ticket.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section :if={@signed_out?} class="text-center py-8">
      <p class="text-sm opacity-60 mb-3">
        Start exploring &mdash; your first days of travel are on us.
      </p>
      <a href="/auth/google" class="btn btn-primary btn-lg">
        Send out your poet
      </a>
    </section>
  </main>
</div>
