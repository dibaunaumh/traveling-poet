<Layouts.app flash={@flash} current_user={assigns[:current_user]}>
  <article class="legal">
    <h1>{gettext("This link does not work")}</h1>
    <p>
      <.rich text={
        gettext("You can turn the daily emails off under Notifications in %{settings}.",
          settings: marker(:settings)
        )
      }>
        <:part name="settings">
          <.link navigate={~p"/settings"} class="link">{gettext("Settings")}</.link>
        </:part>
      </.rich>
    </p>
  </article>
</Layouts.app>
