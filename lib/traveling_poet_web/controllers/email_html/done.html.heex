<Layouts.app flash={@flash} current_user={assigns[:current_user]}>
  <article class="legal" id="email-unsubscribed">
    <h1>No more daily emails</h1>
    <p>
      Your poet keeps writing. To get the emails again, turn them back on under
      Notifications in <.link navigate={~p"/settings"} class="link">Settings</.link>.
    </p>
  </article>
</Layouts.app>
