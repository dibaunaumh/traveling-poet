<Layouts.app flash={@flash} current_user={assigns[:current_user]}>
  <article class="legal" id="email-unsubscribed">
    <h1>{gettext("No more daily emails")}</h1>
    <p>
      <.rich text={
        gettext(
          "Your poet keeps writing. To get the emails again, turn them back on under Notifications in %{settings}.",
          settings: marker(:settings)
        )
      }>
        <:part name="settings">
          <.link navigate={~p"/settings"} class="link">{gettext("Settings")}</.link>
        </:part>
      </.rich>
    </p>
  </article>
</Layouts.app>
