<Layouts.app flash={@flash} current_user={assigns[:current_user]}>
  <article class="item-page" id={"item-#{@facts.item.id}"}>
    <p class="item-kind">
      <span :if={is_nil(@facts.item.city)}>{kind_label(@kind_word)}</span>
      <span :if={@facts.item.city}>
        {dgettext("guide", "%{kind} in %{city}",
          kind: kind_label(@kind_word),
          city: @facts.item.city
        )}
      </span>
    </p>
    <h1 class="text-2xl font-bold">{@facts.item.name}</h1>
    <p :if={date_range(@facts.item)} class="item-when">{date_range(@facts.item)}</p>
    <p :if={@facts.item.era} class="item-when">{@facts.item.era}</p>

    <div
      :if={@facts.topics != []}
      class="discover-subjects"
      aria-label={dgettext("guide", "Subjects")}
    >
      <a
        :for={{path, names} <- @facts.topics}
        href={~p"/discover?view=village&topic=#{path}"}
        class="discover-subject"
      >
        {Enum.join(names, " › ")}
      </a>
    </div>

    <p class="item-found">
      {dgettext("guide", "Found by %{poets}", poets: Enum.map_join(@facts.poets, ", ", & &1.name))}
    </p>

    <section
      :if={@facts.notes != []}
      class="item-notes"
      aria-label={dgettext("guide", "What the poets wrote")}
    >
      <blockquote :for={note <- @facts.notes} :if={note.blurb} class="item-note">
        <p>{note.blurb}</p>
        <footer>
          <a href={~p"/p/#{note.poet.slug}/#{Date.to_iso8601(note.date)}"} class="link">
            {note.poet.name}
          </a>, {fmt(
            note.date
          )}<span :if={note.rating}>, {dgettext("guide", "%{poet}'s pick: %{rating} of 5",
            poet: note.poet.name,
            rating: note.rating
          )}</span>
        </footer>
      </blockquote>
    </section>

    <ul
      :if={@facts.related != []}
      class="discover-related"
      aria-label={dgettext("guide", "Related")}
    >
      <li :for={r <- @facts.related}>
        {phrase(r.relation, r.direction)}
        <a href={~p"/items/#{r.item.slug}"} class="link">{r.item.name}</a>
      </li>
    </ul>

    <p :if={@facts.editions != []} class="item-editions">
      {dgettext("guide", "Earlier:")}
      <a
        :for={e <- @facts.editions}
        href={~p"/items/#{e.slug}"}
        class="link"
      >{e.name}<span :if={e.time_start}> ({fmt(e.time_start)})</span></a>
    </p>

    <p :if={@facts.parent} class="text-sm opacity-70">
      {dgettext("guide", "In %{place}", place: @facts.parent.name)}
    </p>

    <div class="discover-links">
      <a :if={@maps_url} href={@maps_url} class="link" target="_blank" rel="noopener">
        {dgettext("guide", "Open in Google Maps")}
      </a>
      <a href={~p"/discover"} class="link">{dgettext("guide", "Discover")}</a>
      <a
        href={~p"/items/#{@facts.item.slug}/jsonld"}
        class="link"
        rel="alternate"
        type="application/ld+json"
      >
        {dgettext("guide", "Data")}
      </a>
    </div>
  </article>
  <%!-- Embedded data: escaped by Jason's :html_safe, so no </script> can close it early. --%>
  <script type="application/ld+json">
    <%= raw(@json_ld) %>
  </script>
</Layouts.app>
