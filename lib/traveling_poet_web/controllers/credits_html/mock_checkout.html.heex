<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="mx-auto max-w-md py-12">
    <div class="alert alert-warning mb-6 text-sm">
      <.icon name="hero-beaker" class="size-5" />
      <span>MOCK CHECKOUT — no real payment happens here. Testing only.</span>
    </div>
    <h1 class="text-2xl font-semibold mb-2">{@pack.credits} credits</h1>
    <p class="opacity-70 mb-6">
      ${:erlang.float_to_binary(@pack.cents / 100, decimals: 2)}
    </p>
    <form method="post" action={~p"/credits/mock-checkout/confirm"} class="flex gap-2">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <input type="hidden" name="token" value={@token} />
      <button type="submit" class="btn btn-primary">Pay (mock)</button>
      <.link navigate={~p"/settings"} class="btn btn-ghost">Cancel</.link>
    </form>
  </div>
</Layouts.app>
