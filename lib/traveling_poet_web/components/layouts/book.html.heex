<!DOCTYPE html> <%!-- A book reads in its pages' language, not the interface's --%>
<html
  lang={assigns[:book_language] || "en"}
  dir={TravelingPoet.Locale.dir(assigns[:book_language])}
>
  <head>
    <meta charset="utf-8" />
    <%!-- the words the page's scripts write, in the reader's language (assets/js/strings.js) --%>
    <script>
      window.tpStrings = <%= raw(TravelingPoetWeb.I18n.js_strings_json()) %>
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "Traveling Poet"}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={~p"/favicon.ico"} />
    <%!-- The book carries its own fonts (see assets/css/fonts.css) and no app
          chrome: paged.js lays the DOM out into pages, so nothing here may
          expect LiveView to patch it. --%>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/book.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/book.js"}>
    </script>
  </head>
  <body class="book">
    {@inner_content}
  </body>
</html>
