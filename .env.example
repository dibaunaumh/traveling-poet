# Copy to .env — runtime.exs auto-loads it in dev.

# Google OAuth (login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL the sprite's agent calls back to (must be reachable FROM the sprite;
# use an ngrok/tailscale URL in dev, the Fly URL in prod)
PHOENIX_URL=http://localhost:4000

# sprites.dev
SPRITES_TOKEN=
SPRITES_API_URL=https://api.sprites.dev/v1
# Optional prefix for sprite names, e.g. "tpoetdev" -> sandbox-tpoetdev-<user_id>
SPRITE_NAMESPACE=

# OpenClaw agent
OPENCLAW_STABLE_VERSION=2026.4.9
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Trip Scout poets get a reliable model (their output informs real trips)
SCOUT_MODEL=anthropic/claude-sonnet-4.6

# Illustration generation — an OpenRouter image-output model slug
# (billed on OPENROUTER_API_KEY; no separate key needed)
IMAGE_GEN_MODEL=google/gemini-2.5-flash-image

# Telegram central bot (leave blank to disable Telegram entirely)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Web Push (browser/PWA notifications when an entry is published).
# Generate once with `mix tpoet.gen_vapid_keys`; leave blank to hide the feature.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:); defaults to PHOENIX_URL
VAPID_SUBJECT=

# Tigris object storage (illustrations)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
TIGRIS_BUCKET_NAME=traveling-poet-dev

# Daily journey scheduler (0/absent = disabled)
JOURNEY_CHECK_INTERVAL_MINUTES=0

# Feedback markers: how often to look for pending markers (0/absent = never
# sent), how long the reader must be quiet before the poet is told, and the
# per-user daily cap on revision turns
MARKER_DELIVERY_INTERVAL_MINUTES=0
MARKER_QUIET_MINUTES=15
DAILY_MARKER_REVISIONS_CAP=4

# Per-user daily quota caps
DAILY_RUNS_CAP=1
DAILY_CHAT_TURNS_CAP=50
DAILY_IMAGE_CAP=6

# Credits (whole credits per daily run; welcome grant; low-balance alert days)
CREDIT_RATE_WANDER=1
CREDIT_RATE_SCOUT=5
# A composed book edition: base + per chapter, capped
BOOK_COMPOSE_CREDITS_BASE=2
BOOK_COMPOSE_CREDITS_PER_CHAPTER=1
BOOK_COMPOSE_CREDITS_MAX=10
DAILY_BOOK_COMPOSE_CAP=2
# PDFs of the book, rendered on each poet's sprite: all | admins | off
BOOK_PDF_ENABLED=all
DAILY_BOOK_PDF_CAP=4
SIGNUP_CREDITS=10
LOW_CREDITS_DAYS=3

# Stripe (leave blank for the mock checkout page). Webhook endpoint:
# https://<host>/webhooks/stripe, event checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Change stream: batched CRUD webhooks for external operator agents
# (register receivers at /admin/change-stream). Poll 0/absent = disabled.
CHANGE_STREAM_POLL_SECONDS=0
CHANGE_STREAM_BATCH_SIZE=100
CHANGE_STREAM_MAX_BATCH_WAIT_SECONDS=60
CHANGE_STREAM_FAILURE_THRESHOLD=5
